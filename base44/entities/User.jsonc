{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "driver",
        "shipper"
      ],
      "default": "driver"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "driver",
        "shipper"
      ],
      "default": "driver"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "profile_id": {
      "type": "string",
      "description": "DriverProfile or ShipperProfile id"
    }
  },
  "required": []
}