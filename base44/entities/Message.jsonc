{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Format: smaller_user_id_larger_user_id"
    },
    "sender_id": {
      "type": "string"
    },
    "receiver_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "load_id": {
      "type": "string",
      "description": "Optional reference to a load"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "receiver_id",
    "content"
  ]
}