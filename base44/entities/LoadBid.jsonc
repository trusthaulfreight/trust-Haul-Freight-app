{
  "name": "LoadBid",
  "type": "object",
  "properties": {
    "load_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_user_id": {
      "type": "string"
    },
    "bid_amount": {
      "type": "number"
    },
    "message": {
      "type": "string"
    },
    "estimated_pickup": {
      "type": "string",
      "format": "date"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "withdrawn"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional additional details about this bid"
    }
  },
  "required": [
    "load_id",
    "driver_id",
    "bid_amount"
  ]
}